pipeline {
    agent any

    parameters {
        choice(
            name: 'ENV',
            choices: ['dev', 'staging'],
            description: 'Target deployment environment'
        )
        string(
            name: 'APP_PORT',
            defaultValue: '8080',
            description: 'Port for the deployed application'
        )
    }

    stages {
        stage('Checkout') {
            steps {
                echo "Source code workspace ready for Build #${BUILD_NUMBER}"
            }
        }

        stage('Compile') {
            steps {
                bat './mvnw.cmd clean compile'
            }
        }

        stage('Test & Quality Gate') {
            steps {
                bat './mvnw.cmd test'
            }
            post {
                always {
                    junit testResults: '**/target/surefire-reports/*.xml', allowEmptyResults: true
                    archiveArtifacts artifacts: 'target/screenshots/*.png', allowEmptyArchive: true
                }
            }
        }

        stage('Package') {
            steps {
                bat "./mvnw.cmd package -DskipTests -Dspring.profiles.active=${params.ENV}"
            }
            post {
                success {
                    archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                }
            }
        }

        stage('Deploy') {
            when {
                expression { currentBuild.currentResult == 'SUCCESS' }
            }
            steps {
                bat "deploy.bat ${params.ENV} ${params.APP_PORT}"
            }
        }

        stage('Health Check') {
            steps {
                sleep time: 10, unit: 'SECONDS'
                bat "curl.exe -s -I http://localhost:${params.APP_PORT}/incidents || echo Starting up..."
            }
        }
    }

    post {
        success {
            echo "Pipeline succeeded! Application active at http://localhost:${params.APP_PORT}/incidents"
        }
        failure {
            echo "Pipeline failed! Check console log for details."
        }
    }
}
